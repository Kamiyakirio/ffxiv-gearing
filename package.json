{
  "name": "ffxiv-gearing",
  "version": "0.0.1",
  "description": "Final Fantasy XIV Gearing",
  "keywords": [
    "final-fantasy-xiv",
    "ffxiv"
  ],
  "homepage": "https://asvel.github.io/ffxiv-gearing/",
  "license": "MIT",
  "repository": "https://github.com/Asvel/ffxiv-gearing",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --project src/tsconfig.json && vite build",
    "analyze": "vite build --mode production",
    "preview": "vite preview",
    "publish": "node publish.ts",
    "data-fetch": "node data/fetch.ts",
    "data-convert": "node data/convert.ts",
    "lint": "eslint --ext .js,.cjs,.ts,.tsx ."
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "clsx": "^2.1.1",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "mobx-state-tree": "^7.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanitize.css": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/shelljs": "^0.10.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.3",
    "confusing-browser-globals": "^1.0.11",
    "eslint": "^8.57.0",
    "eslint-config-alloy": "^5.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "json5": "^2.2.3",
    "papaparse": "^5.5.3",
    "sass-embedded": "^1.99.0",
    "shelljs": "^0.10.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.5"
  },
  "overrides": {
    "eslint-config-alloy": {
      "typescript": "$typescript"
    }
  }
}
